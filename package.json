{
  "name": "azelkhanov-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "preview": "node scripts/preview.mjs",
    "build": "next build && node scripts/finalize-export.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "tokens": "node scripts/tokens.mjs",
    "design:lint": "design.md lint DESIGN.md",
    "fonts": "python3 scripts/fonts.py",
    "shots": "node scripts/shots.mjs",
    "check:showcase": "node scripts/check-showcase.mjs",
    "check:demos": "node scripts/check-demos.mjs",
    "check:playground": "node scripts/check-playground.mjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/geologica": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@google/design.md": "0.4.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "playwright": "1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "4.3.3",
    "three": "0.186.1",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
